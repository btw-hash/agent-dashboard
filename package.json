{
  "name": "agent-dashboard",
  "version": "3.0.0",
  "description": "A pixel-art office where every running AI agent is a person",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n srv,vite -c green,magenta \"node server.js\" \"npx vite\"",
    "build": "npx vite build",
    "start": "node server.js",
    "preview": "npx vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "chokidar": "^3.6.0",
    "dotenv": "^17.4.0",
    "three": "^0.187.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "vite": "^8.0.3",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": "prettier --write"
  },
  "bin": {
    "agent-office": "bin/agent-office.js"
  },
  "files": [
    "bin",
    "server.js",
    "src/server",
    "dist"
  ]
}
